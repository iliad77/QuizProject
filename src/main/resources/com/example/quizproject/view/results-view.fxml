<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.quizproject.controller.ResultsController"
      alignment="CENTER"
      spacing="20"
      prefWidth="600"
      prefHeight="400">

    <Label text="Quiz Completed!"
           style="-fx-font-size: 28px; -fx-font-weight: bold;" />

    <Label fx:id="playerLabel"
           text="Player:"
           style="-fx-font-size: 18px;" />

    <Label fx:id="scoreLabel"
           text="Score: 0/0"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <Button text="Back to Menu"
            onAction="#handleBackToMenu"
            prefWidth="180" />

</VBox>
