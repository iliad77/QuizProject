<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.quizproject.controller.GameController"
      alignment="CENTER"
      spacing="20"
      prefWidth="600"
      prefHeight="400">

    <Label fx:id="playerLabel"
           text="Player:"
           style="-fx-font-size: 16px;" />

    <Label fx:id="scoreLabel"
           text="Score: 0"
           style="-fx-font-size: 16px;" />

    <Label fx:id="questionLabel"
           text="Question will appear here"
           wrapText="true"
           style="-fx-font-size: 22px; -fx-font-weight: bold;" />

    <VBox fx:id="answersBox"
          alignment="CENTER_LEFT"
          spacing="10"
          maxWidth="400" />

    <Button fx:id="nextButton"
            text="Next Question"
            disable="true"
            prefWidth="150"
            onAction="#handleNextQuestion"/>

</VBox>

